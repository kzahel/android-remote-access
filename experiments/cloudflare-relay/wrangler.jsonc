{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yepcontrol-relay-proof",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://proof.invalid"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "Admission"
      },
      {
        "name": "PAIRINGS",
        "class_name": "Pairing"
      },
      {
        "name": "WAKE_BUDGET",
        "class_name": "WakeBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Pairing"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WakeBudget"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Admission"]
    }
  ],
  "ratelimits": [
    {
      "name": "HTTP_LIMITER",
      "namespace_id": "340001",
      "simple": { "limit": 240, "period": 60 }
    },
    {
      "name": "START_LIMITER",
      "namespace_id": "340002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
